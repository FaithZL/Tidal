@@ -0,0 +1,45 @@
+import { FilesetResolver, PoseLandmarker } from '@mediapipe/tasks-vision';
+import type { WorkerRequest, WorkerResponse } from './types.js';
+
+let landmarker: PoseLandmarker | null = null;
+let epoch = 0;
+let disposed = false;
+const reply = (message: WorkerResponse): void => self.postMessage(message);
+self.onmessage = async ({ data }: MessageEvent<WorkerRequest>): Promise<void> => {
+  if (data.kind === 'dispose') {
+    disposed = true; landmarker?.close(); landmarker = null;
+    reply({ kind: 'disposed' }); return;
+  }
+  try {
+    if (data.kind === 'init') {
+      epoch = data.sourceEpoch;
+      const modelUrl = new URL('models/pose_landmarker_lite.task', data.baseUrl).href;
+      const response = await fetch(modelUrl);
+      if (!response.ok) throw new Error(`模型资源加载失败（HTTP ${response.status}），请运行 npm run assets:sync`);
+      const modelAssetBuffer = new Uint8Array(await response.arrayBuffer());
+      const files = await FilesetResolver.forVisionTasks(new URL('mediapipe/wasm', data.baseUrl).href);
+      const model = await PoseLandmarker.createFromOptions(files, {
+        baseOptions: { modelAssetBuffer, delegate: 'CPU' },
+        runningMode: 'VIDEO', numPoses: 1,
+        outputSegmentationMasks: false,
+      });
+      if (disposed) { model.close(); return; }
+      landmarker = model;
+      reply({ kind: 'ready', sourceEpoch: epoch });
+    } else {
+      try {
+        if (!landmarker || disposed || data.sourceEpoch !== epoch) return;
+        const start = performance.now();
+        const result = landmarker.detectForVideo(data.bitmap, data.capturedAtMs);
+        const landmarks = result.landmarks[0] ?? [];
+        reply({ kind: 'frame', sourceEpoch: epoch, requestId: data.requestId, frame: {
+          frameId: data.requestId, capturedAtMs: data.capturedAtMs, width: data.width, height: data.height,
+          landmarks, valid: landmarks.length === 33 && landmarks.every(p => [p.x, p.y, p.z].every(Number.isFinite)),
+          inferenceMs: performance.now() - start,
+        } });
+      } finally { data.bitmap.close(); }
+    }
+  } catch (error) {
+    if (!disposed) reply({ kind: 'error', sourceEpoch: epoch, message: `模型/推理失败：${error instanceof Error ? error.message : String(error)}` });
+  }
+};
diff --git a/src/pose/poseWorkerClient.ts b/src/pose/poseWorkerClient.ts
new file mode 100644
index 0000000..52a8b9c
--- /dev/null
+++ b/src/pose/poseWorkerClient.ts
@@ -0,0 +1,87 @@
+import type { PoseFrame, WorkerRequest, WorkerResponse } from './types.js';
+export interface WorkerPort {
+  onmessage: ((event: MessageEvent<WorkerResponse>) => void) | null;
+  onerror: ((event: ErrorEvent) => void) | null;
+  postMessage(message: WorkerRequest, transfer?: Transferable[]): void;
+  terminate(): void;
+}
+export class PoseWorkerClient {
+  private worker: WorkerPort | null = null;
+  private epoch = 0;
+  private nextId = 0;
+  private pending: { id: number; capturedAtMs: number } | null = null;
+  private ready = false;
+  private rejectStart: ((error: Error) => void) | null = null;
+  private initTimer: ReturnType<typeof setTimeout> | undefined;
+  private frameTimer: ReturnType<typeof setTimeout> | undefined;
+  constructor(
+    private readonly factory: () => WorkerPort = () => new Worker(new URL('worker/pose.js', this.baseUrl)),
+    private readonly bitmap = (video: HTMLVideoElement) => createImageBitmap(video),
+    private readonly baseUrl = new URL(import.meta.env.BASE_URL, location.href).href,
+  ) {}
+  async start(onFrame: (frame: PoseFrame) => void, onError: (message: string) => void = () => {}): Promise<void> {
+    const stopping = this.stop();
+    const epoch = this.epoch;
+    await stopping;
+    if (epoch !== this.epoch) throw new DOMException('Cancelled', 'AbortError');
+    const worker = this.factory(); this.worker = worker;
+    return new Promise<void>((resolve, reject) => {
+      this.rejectStart = reject;
+      const fail = (message: string): void => {
+        if (epoch !== this.epoch) return;
+        reject(new Error(message)); this.rejectStart = null;
+        void this.stop(); onError(message);
+      };
+      this.initTimer = setTimeout(() => fail('模型初始化超时（30 秒），请重试'), 30_000);
+      worker.onerror = () => fail('推理 Worker 失败，请重试或选择键盘演示');
+      worker.onmessage = ({ data }) => {
+        if (epoch !== this.epoch || data.kind === 'disposed' || data.sourceEpoch !== epoch) return;
+        if (data.kind === 'ready') {
+          clearTimeout(this.initTimer); this.ready = true; this.rejectStart = null; resolve();
+        } else if (data.kind === 'error') fail(data.message);
+        else if (data.kind === 'frame' && this.pending?.id === data.requestId && data.frame.capturedAtMs === this.pending.capturedAtMs) {
+          clearTimeout(this.frameTimer); this.pending = null; onFrame(data.frame);
+        }
+      };
+      worker.postMessage({ kind: 'init', sourceEpoch: epoch, baseUrl: this.baseUrl });
+    });
+  }
+  submit(video: HTMLVideoElement, capturedAtMs: number): void {
+    const worker = this.worker, epoch = this.epoch;
+    if (!worker || !this.ready || this.pending || video.readyState < 2 || !Number.isFinite(capturedAtMs)) return;
+    const requestId = ++this.nextId;
+    this.pending = { id: requestId, capturedAtMs };
+    this.frameTimer = setTimeout(() => {
+      if (epoch === this.epoch) worker.onmessage?.({ data: { kind: 'error', sourceEpoch: epoch, message: '推理超时，请重试' } } as MessageEvent<WorkerResponse>);
+    }, 10_000);
+    void this.bitmap(video).then(bitmap => {
+      if (epoch !== this.epoch) { bitmap.close(); return; }
+      try {
+        worker.postMessage({ kind: 'frame', sourceEpoch: epoch, requestId, capturedAtMs,
+          width: video.videoWidth, height: video.videoHeight, bitmap }, [bitmap]);
+      } catch (error) {
+        bitmap.close(); throw error;
+      }
+    }).catch(error => {
+      if (epoch === this.epoch) worker.onmessage?.({ data: { kind: 'error', sourceEpoch: epoch, message: `视频帧读取失败：${String(error)}` } } as MessageEvent<WorkerResponse>);
+    });
+  }
+  async stop(): Promise<void> {
+    this.epoch++; this.ready = false; this.pending = null;
+    clearTimeout(this.initTimer); clearTimeout(this.frameTimer);
+    this.rejectStart?.(new DOMException('Cancelled', 'AbortError')); this.rejectStart = null;
+    const worker = this.worker; this.worker = null;
+    if (!worker) return;
+    await new Promise<void>(resolve => {
+      let done = false;
+      const finish = (): void => {
+        if (done) return; done = true; clearTimeout(timer);
+        worker.onmessage = null; worker.onerror = null; worker.terminate(); resolve();
+      };
+      const timer = setTimeout(finish, 300);
+      worker.onmessage = ({ data }) => { if (data.kind === 'disposed') finish(); };
+      worker.onerror = finish;
+      worker.postMessage({ kind: 'dispose' });
+    });
+  }
+}
diff --git a/src/pose/types.ts b/src/pose/types.ts
new file mode 100644
index 0000000..f0fe98d
--- /dev/null
+++ b/src/pose/types.ts
@@ -0,0 +1,14 @@
+export interface Landmark { x: number; y: number; z: number; visibility?: number; presence?: number }
+export interface PoseFrame {
+  frameId: number; capturedAtMs: number; width: number; height: number;
+  landmarks: readonly Landmark[]; valid: boolean; inferenceMs: number;
+}
+export type WorkerRequest =
+  | { kind: 'init'; sourceEpoch: number; baseUrl: string }
+  | { kind: 'frame'; sourceEpoch: number; requestId: number; capturedAtMs: number; width: number; height: number; bitmap: ImageBitmap }
+  | { kind: 'dispose' };
+export type WorkerResponse =
+  | { kind: 'ready'; sourceEpoch: number }
+  | { kind: 'frame'; sourceEpoch: number; requestId: number; frame: PoseFrame }
+  | { kind: 'error'; sourceEpoch: number; message: string }
+  | { kind: 'disposed' };
diff --git a/src/ui/setupPanel.ts b/src/ui/setupPanel.ts
new file mode 100644
index 0000000..d63e3dd
--- /dev/null
+++ b/src/ui/setupPanel.ts
@@ -0,0 +1,95 @@
+import { CameraService } from '../pose/cameraService.js';
+import { PoseWorkerClient } from '../pose/poseWorkerClient.js';
+import type { PoseFrame } from '../pose/types.js';
+
+const links = [[11, 12], [11, 13], [13, 15], [12, 14], [14, 16], [11, 23], [12, 24], [23, 24], [23, 25], [25, 27], [24, 26], [26, 28]];
+export class SetupPanel {
+  private readonly camera: CameraService;
+  private readonly client = new PoseWorkerClient();
+  private epoch = 0;
+  private timer: ReturnType<typeof setInterval> | undefined;
+  private slowTimer: ReturnType<typeof setTimeout> | undefined;
+  private timeout: ReturnType<typeof setTimeout> | undefined;
+  private lastVideoTime = -1;
+  private frameCount = 0;
+  private sampleStart = 0;
+  private timings: number[] = [];
+  constructor(video: HTMLVideoElement, private readonly overlay: HTMLCanvasElement,
+    private readonly status: HTMLElement, private readonly metrics: HTMLElement, private readonly frames: HTMLElement,
+    private readonly startButton: HTMLButtonElement) {
+    this.camera = new CameraService(video);
+  }
+  async start(): Promise<void> {
+    const stopping = this.stop();
+    const epoch = this.epoch;
+    await stopping;
+    if (epoch !== this.epoch) return;
+    this.startButton.disabled = true;
+    this.status.textContent = '正在请求摄像头权限（仅视频）…';
+    this.slowTimer = setTimeout(() => { if (epoch === this.epoch) this.status.textContent = '摄像头/模型加载较慢，可取消或重试'; }, 10_000);
+    this.timeout = setTimeout(() => { if (epoch === this.epoch) this.fail('初始化超时（30 秒），请重试或选择键盘演示'); }, 30_000);
+    try {
+      if (!navigator.mediaDevices?.getUserMedia) throw new Error('浏览器不支持摄像头：请使用 localhost 或 HTTPS');
+      const video = await this.camera.start();
+      if (epoch !== this.epoch) return;
+      (video.srcObject as MediaStream).getTracks().forEach(track => {
+        track.addEventListener('ended', () => { if (epoch === this.epoch) this.fail('摄像头已断开，请重试'); }, { once: true });
+      });
+      this.status.textContent = '摄像头已打开，正在加载本地模型与 WASM…';
+      await this.client.start(frame => { if (epoch === this.epoch) this.draw(frame); }, message => {
+        if (epoch === this.epoch) this.fail(message);
+      });
+      if (epoch !== this.epoch) return;
+      clearTimeout(this.slowTimer); clearTimeout(this.timeout);
+      this.status.textContent = '推理中 · Worker / CPU · 仅关键点诊断，尚未接入运动识别';
+      this.sampleStart = performance.now();
+      this.timer = setInterval(() => {
+        if (document.hidden || video.currentTime === this.lastVideoTime) return;
+        this.lastVideoTime = video.currentTime;
+        this.client.submit(video, performance.now());
+      }, 1000 / 15);
+    } catch (error) {
+      if (epoch !== this.epoch) return;
+      const name = error instanceof Error ? error.name : '';
+      const messages: Record<string, string> = {
+        NotAllowedError: '摄像头权限被拒绝，请在浏览器允许视频权限后重试',
+        NotFoundError: '未找到摄像头，请连接设备后重试',
+        NotReadableError: '摄像头被占用或无法读取，请关闭其他占用程序后重试',
+        NotSupportedError: '当前浏览器或摄像头设备不支持视频读取，请换用桌面 Chrome/Edge 或检查设备后重试',
+      };
+      this.fail(messages[name] ?? (error instanceof Error ? error.message : String(error)));
+    }
+  }
+  private fail(message: string): void {
+    void this.stop(); this.status.textContent = message;
+  }
+  private draw(frame: PoseFrame): void {
+    this.frames.textContent = String(++this.frameCount);
+    this.timings.push(frame.inferenceMs); if (this.timings.length > 120) this.timings.shift();
+    const times = [...this.timings].sort((a, b) => a - b);
+    const p50 = times[Math.floor((times.length - 1) * .5)];
+    const p95 = times[Math.floor((times.length - 1) * .95)];
+    const hz = this.frameCount * 1000 / Math.max(1, performance.now() - this.sampleStart);
+    this.metrics.textContent = `${frame.width}×${frame.height} · ${frame.landmarks.length} 个关键点 · ${hz.toFixed(1)} Hz · 推理 p50/p95 ${p50.toFixed(0)}/${p95.toFixed(0)}ms · 样本年龄 ${(performance.now() - frame.capturedAtMs).toFixed(0)}ms · ${frame.valid ? '人体关键点可用' : '未检测到人体'}`;
+    this.overlay.width = frame.width; this.overlay.height = frame.height;
+    const ctx = this.overlay.getContext('2d'); if (!ctx) return;
+    ctx.clearRect(0, 0, frame.width, frame.height);
+    ctx.strokeStyle = '#93ffb4'; ctx.fillStyle = '#ffe59b'; ctx.lineWidth = 3;
+    const visible = (i: number) => (frame.landmarks[i]?.visibility ?? 0) >= .6;
+    for (const [a, b] of links) {
+      if (!visible(a) || !visible(b)) continue;
+      const p = frame.landmarks[a], q = frame.landmarks[b];
+      ctx.beginPath(); ctx.moveTo(p.x * frame.width, p.y * frame.height); ctx.lineTo(q.x * frame.width, q.y * frame.height); ctx.stroke();
+    }
+    frame.landmarks.forEach((p, i) => { if (visible(i)) { ctx.beginPath(); ctx.arc(p.x * frame.width, p.y * frame.height, 4, 0, Math.PI * 2); ctx.fill(); } });
+  }
+  async stop(): Promise<void> {
+    this.epoch++; clearInterval(this.timer); clearTimeout(this.slowTimer); clearTimeout(this.timeout);
+    this.camera.stop(); this.lastVideoTime = -1; this.frameCount = 0; this.timings = [];
+    this.frames.textContent = '0'; this.metrics.textContent = '';
+    this.overlay.getContext('2d')?.clearRect(0, 0, this.overlay.width, this.overlay.height);
+    this.startButton.disabled = false;
+    this.status.textContent = '摄像头已关闭；点击开始诊断才请求视频权限';
+    await this.client.stop();
+  }
+}
