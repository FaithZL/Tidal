diff --git a/src/game/FarmScene.ts b/src/game/FarmScene.ts
new file mode 100644
index 0000000..a90ed30
--- /dev/null
+++ b/src/game/FarmScene.ts
@@ -0,0 +1,91 @@
+import Phaser from 'phaser';
+import type { DemoConfig } from '../config/demoConfig.js';
+import type { ActionPhase, SessionController, SessionSnapshot } from '../domain/types.js';
+
+/** T04 greybox: geometry follows snapshots/effects, never mutates inventory. */
+export class FarmScene extends Phaser.Scene {
+  private snapshot: Readonly<SessionSnapshot>;
+  private action: ActionPhase = 'ready';
+  private ink!: Phaser.GameObjects.Graphics;
+  private caption!: Phaser.GameObjects.Text;
+  private impactUntil = 0;
+
+  constructor(private readonly controller: SessionController, private readonly config: Readonly<DemoConfig>) {
+    super('Farm');
+    this.snapshot = controller.getSnapshot();
+  }
+  create(): void {
+    this.ink = this.add.graphics();
+    this.caption = this.add.text(40, 32, '', { fontFamily: 'Microsoft YaHei, sans-serif', fontSize: '22px', color: '#264a36' });
+    const unsubscribe = this.controller.subscribe(s => { this.snapshot = s; });
+    const uneffect = this.controller.onEffect(e => {
+      if (e.sessionId !== this.controller.getSnapshot().sessionId) return;
+      if (e.kind === 'action-phase') this.action = e.phase;
+      if (e.kind === 'action-impact') this.impactUntil = this.time.now + 160;
+      if (e.kind === 'task-changed' || e.kind === 'session-reset') { this.action = 'ready'; this.impactUntil = 0; }
+    });
+    this.events.once(Phaser.Scenes.Events.SHUTDOWN, () => { unsubscribe(); uneffect(); });
+  }
+  update(): void {
+    const g = this.ink, s = this.snapshot;
+    g.clear();
+    g.fillStyle(0xc9e1bf).fillRect(0, 0, 1280, 720);
+    g.fillStyle(0x8bb779).fillEllipse(300, 390, 1100, 650);
+    g.fillStyle(0xa6c58c).fillEllipse(1080, 450, 900, 650);
+    g.lineStyle(100, 0xd5bf8b).lineBetween(140, 560, 1130, 290);
+    g.lineStyle(3, 0xbba16f).lineBetween(140, 605, 1130, 335);
+    // Home, fencing and garden.
+    g.fillStyle(0xf3d7a3).fillRoundedRect(990, 200, 190, 155, 7);
+    g.fillStyle(0xa56348).fillTriangle(965, 210, 1085, 115, 1200, 210);
+    g.fillStyle(0x654738).fillRect(1060, 265, 48, 90);
+    g.fillStyle(0x82b8bf).fillRect(1125, 238, 33, 40);
+    for (let i = 0; i < 7; i++) g.fillStyle(0xf1ddb2).fillRoundedRect(890 + i * 47, 390, 11, 60, 3);
+    g.fillStyle(0xf1ddb2).fillRect(890, 408, 294, 8);
+    for (let i = 0; i < this.config.treeCount; i++) {
+      const x = 180 + (i % 5) * 138, y = 245 + Math.floor(i / 5) * 100;
+      g.fillStyle(0x886043).fillRect(x - 13, y + 65, 26, i < s.choppedTrees ? 20 : 100);
+      if (i >= s.choppedTrees) {
+        g.fillStyle(0x387858).fillTriangle(x, y - 115, x - 72, y + 105, x + 72, y + 105);
+        g.fillStyle(0x49956b).fillTriangle(x, y - 130, x - 58, y + 30, x + 58, y + 30);
+      }
+    }
+    for (let i = 0; i < s.groundLogs; i++) this.log(170 + (i % 6) * 38, 470 + Math.floor(i / 6) * 20);
+    const carry = s.task === 'carry' || s.phase === 'results';
+    const progress = s.phase === 'results' ? 1 : s.carryActiveMs / this.config.carryTargetMs;
+    const cartX = carry ? 600 + progress * 320 : 680;
+    const cartY = carry ? 505 - progress * 130 : 470;
+    g.fillStyle(0x865c3f).fillRoundedRect(cartX, cartY, 140, 65, 8);
+    g.lineStyle(8, 0x634a37).lineBetween(cartX + 140, cartY + 20, cartX + 190, cartY + 4);
+    g.fillStyle(0x334740).fillCircle(cartX + 28, cartY + 70, 19).fillCircle(cartX + 115, cartY + 70, 19);
+    for (let i = 0; i < s.cartLogs; i++) this.log(cartX + 12 + (i % 4) * 31, cartY - 10 - Math.floor(i / 4) * 16);
+    const playerX = carry ? cartX + 190 : s.task === 'load' ? 570 : 500;
+    const playerY = carry ? cartY + 10 : 407;
+    this.person(playerX, playerY, false);
+    this.person(800, 330, true);
+    if (this.time.now < this.impactUntil) {
+      g.lineStyle(5, 0xffdd77).strokeCircle(playerX + 60, playerY - 20, 35);
+    }
+    this.caption.setText(`地面木材 ${s.groundLogs}    车上 ${s.cartLogs}    到家 ${s.deliveredLogs}\n几何占位 · 阶段：${this.action}`);
+  }
+  private log(x: number, y: number): void {
+    this.ink.fillStyle(0xb27d4e).fillRoundedRect(x, y, 32, 16, 6);
+    this.ink.fillStyle(0xe2b87e).fillCircle(x + 5, y + 8, 6);
+  }
+  private person(x: number, y: number, npc: boolean): void {
+    const g = this.ink;
+    const squat = !npc && this.action === 'squat-down';
+    y += squat ? 23 : 0;
+    g.fillStyle(0x476444, .18).fillEllipse(x, y + 65, 92, 25);
+    g.lineStyle(14, 0x405965).lineBetween(x - 12, y + 20, x - 22, y + 60).lineBetween(x + 12, y + 20, x + 24, y + 60);
+    g.fillStyle(npc ? 0xc8b5d4 : 0xe5ad59).fillRoundedRect(x - 25, y - 38, 50, 66, 10);
+    g.fillStyle(npc ? 0x729db0 : 0xf5d1a0).fillCircle(x, y - 63, 25);
+    g.fillStyle(0x8e633c).fillRoundedRect(x - 35, y - 87, 70, 12, 4);
+    const raised = !npc && (this.action === 'press-up' || this.action === 'ready' || this.action === 'chop-return');
+    const handY = raised ? y - 85 : y;
+    g.lineStyle(12, npc ? 0x729db0 : 0xf5d1a0).lineBetween(x + 21, y - 27, x + 52, handY);
+    if (!npc && this.snapshot.task === 'chop') {
+      g.lineStyle(6, 0x745036).lineBetween(x + 52, handY + 8, x + 68, handY - 42);
+      g.fillStyle(0xdbe3d9).fillTriangle(x + 65, handY - 45, x + 92, handY - 48, x + 86, handY - 22);
+    }
+  }
+}
diff --git a/src/game/createGame.ts b/src/game/createGame.ts
new file mode 100644
index 0000000..5fef5cd
--- /dev/null
+++ b/src/game/createGame.ts
@@ -0,0 +1,15 @@
+import Phaser from 'phaser';
+import type { DemoConfig } from '../config/demoConfig.js';
+import type { SessionController } from '../domain/types.js';
+import { FarmScene } from './FarmScene.js';
+
+/** Rendering subscribes to authority; it never advances the session clock. */
+export function createGame(parent: HTMLElement, controller: SessionController, config: Readonly<DemoConfig>): Phaser.Game {
+  return new Phaser.Game({
+    type: Phaser.AUTO, parent, width: 1280, height: 720, backgroundColor: '#95c6ac',
+    scale: { mode: Phaser.Scale.FIT, autoCenter: Phaser.Scale.CENTER_BOTH },
+    scene: [new FarmScene(controller, config)],
+    audio: { noAudio: true },
+    callbacks: { postBoot: () => { parent.dataset.renderer = `Phaser ${Phaser.VERSION}`; } },
+  });
+}
