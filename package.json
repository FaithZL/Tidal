{
  "name": "tidal-farm-motion-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phaser farm exercise demo with keyboard flow and local MediaPipe diagnostics",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && npm run build:worker && vite build",
    "build:local": "npm run build",
    "preview": "vite preview",
    "assets:sync": "node scripts/sync-vision-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e && npm run build",
    "build:worker": "vite build --config vite.worker.config.ts",
    "predev": "npm run build:worker",
    "predev:local": "npm run build:worker"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.7.2",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "phaser": "3.90.0",
    "three": "0.186.1"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
